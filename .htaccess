# =======================
# URL REWRITE: kaliye → aksanti
# =======================
# Transparent redirect from /kaliye/ to /aksanti/
# This allows users to access via localhost/kaliye/ instead of localhost/aksanti/
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /
    
    # If request is for /kaliye/* then rewrite to /aksanti/*
    RewriteCond %{REQUEST_URI} ^/kaliye(/.*)?$
    RewriteRule ^kaliye(/.*)?$ /aksanti$1 [L]
    
    # Prevent direct access to aksanti folder (optional security)
    # This keeps aksanti internal but accessible via kaliye
</IfModule>

# Increase PHP Upload Limits
<IfModule mod_php.c>
    php_value upload_max_filesize 300M
    php_value post_max_size 320M
    php_value memory_limit 512M
    php_value max_execution_time 300
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 300M
    php_value post_max_size 320M
    php_value memory_limit 512M
    php_value max_execution_time 300
</IfModule>
<IfModule mod_php8.c>
    php_value upload_max_filesize 300M
    php_value post_max_size 320M
    php_value memory_limit 512M
    php_value max_execution_time 300
</IfModule>
